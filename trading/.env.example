# =============================================================================
# trading/.env 템플릿 — 실제 키는 .env 로 복사 후 채워 넣는다 (.gitignore 처리됨)
# =============================================================================

# --- Alpaca (미국 주식) ---
# Paper:  https://app.alpaca.markets/paper/dashboard/overview
# Live:   https://app.alpaca.markets/brokerage/dashboard/overview
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
# paper: https://paper-api.alpaca.markets / live: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Binance (글로벌 코인) ---
# Testnet:  https://testnet.binance.vision/
# Live:     https://www.binance.com/en/my/settings/api-management
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_SECRET_KEY=
BINANCE_USE_TESTNET=true

# --- Upbit (국내 코인) ---
# https://upbit.com/mypage/open_api_management
# IP 화이트리스트, 출금 권한 OFF 필수
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
# Upbit는 testnet 없음 — paper 모드에서는 시뮬레이터 사용
UPBIT_USE_PAPER=true

# --- Supabase (web/.env.local과 동일 값 사용) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM 시그널 (VeloTrade RAG 연동) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- 알림 ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# --- 봇 운영 ---
# 전역 안전 가드 — 명시적 false 가 아니면 항상 paper
TRADING_MODE=paper
# 단일 거래 최대 노출 (계좌의 비율, 0~1)
RISK_MAX_POSITION_PCT=0.05
# 일일 손실 한도 (계좌의 비율)
RISK_DAILY_LOSS_PCT=0.02
# 종목당 최대 보유 비율
RISK_PER_SYMBOL_PCT=0.20
