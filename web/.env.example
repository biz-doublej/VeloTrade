# =============================================================================
# VeloTrade — web/.env.local 템플릿
# =============================================================================
# 이 파일을 web/.env.local 로 복사한 뒤 실제 키를 채워 넣는다.
# .env.local 은 .gitignore 로 자동 무시됨 (절대 커밋 금지).

# ---- Supabase (Day 1 필수) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth (Day 8) ----------------------------------------------------------
# 콤마구분 — 이 이메일만 magic link 받을 수 있음 (본인용)
ALLOWED_EMAIL=jaewonjung1004@gmail.com

# ---- 데이터 소스 API (Day 2 이후 사용, Day 1 에 발급 신청만) ----------------
# DART OpenAPI — 한국 전자공시
# https://opendart.fss.or.kr
DART_API_KEY=

# Alpha Vantage — 미국 시세/펀더멘털
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep — 미국 재무/실적
# https://financialmodelingprep.com/developer/docs
FMP_API_KEY=

# 네이버 검색 — 국내 뉴스
# https://developers.naver.com/apps/
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---- LLM (둘 중 하나만 사용) ------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
